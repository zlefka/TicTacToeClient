<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimaryVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/milk">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header: Back button + Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvBack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/current_game_return"
                        android:textColor="#FE7F2D"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGameStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="In progress" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="@string/let_s_play"
                    android:textColor="@color/background"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"/>

                <!-- Players Info Compact -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:background="@drawable/players_info_background"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="24dp">

                    <!-- Player 1 with Symbol -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="start|center_vertical">

                        <ImageView
                            android:id="@+id/ivPlayerOneSymbol"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Player symbol"
                            android:src="@drawable/ic_cross"
                            app:tint="@color/elements"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPlayerOneName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#233D4D"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="You" />
                        </LinearLayout>
                    </LinearLayout>


                    <!-- VS Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/vs"
                        android:textColor="#9E9E9E"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Player 2 with Symbol -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvPlayerTwoName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#233D4D"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"
                                tools:text="Opponent" />

                            <TextView
                                android:id="@+id/tvPlayerTwoTurn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FF03DAC5"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:text="Ходит..."
                                tools:visibility="gone" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivPlayerTwoSymbol"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Player symbol"
                            android:src="@drawable/ic_circle"
                            app:tint="@color/elements"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>



                <!-- Game Board - Centered and Prominent -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="top|center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">

                    <!-- Board Hint -->
                    <TextView
                        android:id="@+id/tvBoardHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textColor="#233D4D"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Ваш ход" />

                    <!-- 3x3 Grid -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell00"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell00Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone"
                                        tools:src="@drawable/ic_cross"
                                        tools:visibility="visible" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell01"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell01Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell02"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell02Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell10"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell10Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell11"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell11Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell12"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell12Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Row 3 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell20"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell20Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell21"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell21Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="92dp"
                                android:layout_height="92dp"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="@color/gray"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E0E0E0"
                                app:strokeWidth="2dp">

                                <FrameLayout
                                    android:id="@+id/cell22"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:id="@+id/cell22Symbol"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="Cell symbol"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Footer: Game UUID -->
                <TextView
                    android:id="@+id/tvGameUuid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    tools:text="ID: 123e4567-e89b-12d3" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</FrameLayout>

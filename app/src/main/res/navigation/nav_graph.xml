<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tictactoemobile.presentation.ui.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_existingGamesFragment"
            app:destination="@id/existingGamesFragment" />
    </fragment>
    <fragment
        android:id="@+id/existingGamesFragment"
        android:name="com.example.tictactoemobile.presentation.ui.ExistingGamesFragment"
        android:label="fragment_exisiting_games"
        tools:layout="@layout/fragment_exisiting_games" />
</navigation>